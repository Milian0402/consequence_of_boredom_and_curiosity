 #endif
 }
 
+static inline void cob_sb_compute_panel(int m, int k, const float* a, int lda,
+    const float* panel, float* c, int ldc)
+{
+    int i = 0;
+    for (; i + cob_sb_rows <= m; i += cob_sb_rows) {
+        cob_sb_full(k, a+(size_t)i*lda, lda, panel, c+(size_t)i*ldc, ldc);
+    }
+    if (i < m) {
+        const float* tail_a = a+(size_t)i*lda;
+        float* tail_c = c+(size_t)i*ldc;
+#define COB_SB_TAIL(rows) case rows: cob_sb_tile(rows, k, tail_a, lda, panel, tail_c, ldc); break
+        switch (m-i) {
+            COB_SB_TAIL(1);
+            COB_SB_TAIL(2);
+#if COB_STREAM_B_AVX512
+            COB_SB_TAIL(3);
+            COB_SB_TAIL(4);
+            COB_SB_TAIL(5);
+#endif
+        }
+#undef COB_SB_TAIL
+    }
+}
