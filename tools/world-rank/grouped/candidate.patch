+#define COB_SB_GROUPED cob_stream_b_grouped_avx512
+#else
+#define COB_SB_GROUPED cob_stream_b_grouped_avx2
 #endif
+
+/* A source row supplies four adjacent micro-panels before moving to the next
+   B row. The packed panels stay separately contiguous along K for the exact
+   same arithmetic kernels used by the single-panel implementation. */
+void COB_SB_GROUPED(int m, int n, int k, const float* a, int lda,
+    const float* b, int ldb, float* c, int ldc, float* panels)
+{
+    const int group_width = COB_STREAM_B_GROUP_PANELS*cob_sb_cols;
+    const size_t panel_size = (size_t)k*cob_sb_cols;
+    const size_t row_bytes = cob_sb_cols*sizeof(float);
+    for (int j = 0; j < n; j += group_width) {
+        int count = COB_STREAM_B_GROUP_PANELS;
+        int col[COB_STREAM_B_GROUP_PANELS];
+        if (n-j >= group_width) {
+            for (int t = 0; t < count; ++t) col[t] = j+t*cob_sb_cols;
+            for (int p = 0; p < k; ++p) {
+                const float* row = b+(size_t)p*ldb+j;
+                float* dst = panels+(size_t)p*cob_sb_cols;
+                for (int t = 0; t < COB_STREAM_B_GROUP_PANELS; ++t)
+                    memcpy(dst+(size_t)t*panel_size,row+t*cob_sb_cols,row_bytes);
+            }
+        } else {
+            /* Preserve the incumbent's last full-width tile: its first column
+               may overlap a predecessor, including one in the previous group. */
+            count = (n-j+cob_sb_cols-1)/cob_sb_cols;
+            for (int t = 0; t < count; ++t) {
+                const int first = j+t*cob_sb_cols;
+                col[t] = first < n-cob_sb_cols ? first : n-cob_sb_cols;
+            }
+            for (int p = 0; p < k; ++p) {
+                const float* row = b+(size_t)p*ldb;
+                float* dst = panels+(size_t)p*cob_sb_cols;
+                for (int t = 0; t < count; ++t)
+                    memcpy(dst+(size_t)t*panel_size,row+col[t],row_bytes);
             }
-#undef COB_SB_TAIL
         }
+        for (int t = 0; t < count; ++t)
+            cob_sb_compute_panel(m,k,a,lda,panels+(size_t)t*panel_size,c+col[t],ldc);
     }
 }
