+#if defined(COB_ENABLE_ARM_STREAM_B) && COB_ENABLE_ARM_STREAM_B && defined(__linux__) && \
+    defined(__aarch64__) && defined(COB_USE_NEON) && defined(__ARM_NEON)
+#define COB_USE_ARM_STREAM_B 1
+#include "cob_arm_stream_b.h"
+
+static int cob_arm_stream_b_eligible(int m, int n, int k,
+    const float* a, int lda, const float* b, int ldb, float* c, int ldc)
+{
+    if (m < 24 || m > 160 || n < 1024 || n > 4096 || k < 96 || k > cob_arm_stream_max_k ||
+        n < 8*m || m*k > 49152 || !a || !b || !c || lda < k || ldb < n || ldc < n)
+        return 0;
+    const size_t count = (size_t)(m - 1)*ldc + n;
+    return !cob_f32_ranges_overlap(c, count, a, (size_t)(m - 1)*lda + k) &&
+           !cob_f32_ranges_overlap(c, count, b, (size_t)(k - 1)*ldb + n);
+}
+#endif
+
 #if defined(COB_ENABLE_N2_SMALL) && COB_ENABLE_N2_SMALL && defined(__linux__) && \
     defined(__aarch64__) && defined(COB_USE_NEON) && defined(__ARM_NEON)
 #define COB_USE_N2_SMALL 1
