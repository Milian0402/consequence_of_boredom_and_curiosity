diff --git a/src/cob_arm_stream_b.c b/src/cob_arm_stream_b.c
new file mode 100644
--- /dev/null
+++ b/src/cob_arm_stream_b.c
@@ -0,0 +1,41 @@
+#include <arm_neon.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include "cob_arm_stream_b.h"
+
+#define COB_N2_TILE_KERNELS_ONLY
+#include "cob_n2_small.inc"
+
+void cob_arm_stream_b_product(int m, int n, int k, const float* a, int lda,
+    const float* b, int ldb, float* c, int ldc)
+{
+    enum { width = cob_arm_stream_width };
+    _Alignas(64) float panel[cob_arm_stream_max_k*width];
+    for (int begin = 0; begin < n; begin += width) {
+        /* A short last panel shifts left. All sources and destinations remain
+           in bounds. Overlapping results repeat the same ordered reduction. */
+        const int j = begin <= n - width ? begin : n - width;
+        for (int p = 0; p < k; ++p)
+            memcpy(panel + (size_t)p*width, b + (size_t)p*ldb + j, width*sizeof(float));
+
+        int i = 0;
+        for (; i <= m - 6; i += 6)
+            n2_full(k, a + (size_t)i*lda, lda, panel, width, c + (size_t)i*ldc + j, ldc);
+        if (i < m) {
+            const float* bottom = a + (size_t)i*lda;
+            float* output = c + (size_t)i*ldc + j;
+            /* Constant row counts remove inactive accumulators from each edge. */
+#define COB_ARM_EDGE(rows) case rows: n2_edge(rows, 4, 4, k, bottom, lda, panel, width, output, ldc); break
+            switch (m - i) {
+                COB_ARM_EDGE(1);
+                COB_ARM_EDGE(2);
+                COB_ARM_EDGE(3);
+                COB_ARM_EDGE(4);
+                COB_ARM_EDGE(5);
+            }
+#undef COB_ARM_EDGE
+        }
+    }
+}
