diff --git a/tools/world-rank/ragged-hk/check-openblas-link.py b/tools/world-rank/ragged-hk/check-openblas-link.py
new file mode 100644
index 0000000000000000000000000000000000000000..0f2c5928490c55e526348f78eefc9adf445366a0
--- /dev/null
+++ b/tools/world-rank/ragged-hk/check-openblas-link.py
@@ -0,0 +1,30 @@
+"""Verify GNU ld's static symbol origins and the ordinary Linux executable's definitions."""
+from pathlib import Path
+import re
+import sys
+
+
+def member(lines, archive, relation, symbol):
+    suffix = ': ' + relation + ' ' + symbol
+    records = {line for line in lines if line.endswith(suffix)}
+    pattern = re.compile(r'(?:^|: )' + re.escape(str(archive)) + r'\(([^()]+)\)' + re.escape(suffix) + '$')
+    matches = {match[1] for line in records if (match := pattern.search(line))}
+    if len(matches) != 1 or (relation == 'definition of' and len(records) != 1):
+        raise ValueError(f'Expected one {archive.name} member with {relation} {symbol}, found {sorted(matches)}')
+    return matches.pop()
+
+
+def verify(cob, openblas, trace, symbols):
+    lines = trace.read_text().splitlines()
+    functions = {row[-1] for line in symbols.read_text().splitlines()
+                 if len(row := line.split()) == 3 and row[1] in ('T', 't')}
+    for api in ('cblas_sgemm', 'openblas_get_num_threads'):
+        if api not in functions:
+            raise ValueError(f'Missing {api} in the statically linked ordinary worker')
+        caller = member(lines, cob, 'reference to', api)
+        provider = member(lines, openblas, 'definition of', api)
+        print(f'{cob.name}({caller}) -> {openblas.name}({provider}): {api}')
+
+
+if __name__ == '__main__':
+    verify(*(Path(arg) for arg in sys.argv[1:]))
diff --git a/tools/world-rank/ragged-hk/test-openblas-link.py b/tools/world-rank/ragged-hk/test-openblas-link.py
new file mode 100644
index 0000000000000000000000000000000000000000..88c90e8bd93f998895ce56a6bdb84dd884481b2f
--- /dev/null
+++ b/tools/world-rank/ragged-hk/test-openblas-link.py
@@ -0,0 +1,44 @@
+"""Check static-provider qualification without executing an SGEMM or requiring a BLAS installation."""
+from contextlib import redirect_stdout
+from io import StringIO
+from pathlib import Path
+from tempfile import TemporaryDirectory
+import runpy
+import unittest
+
+verify = runpy.run_path(str(Path(__file__).with_name('check-openblas-link.py')))['verify']
+COB, BLAS = Path('/install/libcob_matmul.a'), Path('/native/libopenblas.a')
+SYMBOLS = '0000 T cblas_sgemm\n0008 T openblas_get_num_threads\n'
+RECORDS = '\n'.join(f'ld: {archive}({member}): {relation} {api}'
+                    for api, owner in [('cblas_sgemm','cblas_sgemm.o'), ('openblas_get_num_threads','memory.o')]
+                    for archive, member, relation in ((COB,'gemm.c.o','reference to'), (BLAS,owner,'definition of')))
+
+
+class StaticProviderTest(unittest.TestCase):
+    def check(self, trace=RECORDS, nm=SYMBOLS):
+        with TemporaryDirectory() as tmp:
+            log, symbols = Path(tmp)/'link.log', Path(tmp)/'symbols'
+            log.write_text(trace)
+            symbols.write_text(nm)
+            with redirect_stdout(StringIO()):
+                verify(COB, BLAS, log, symbols)
+
+    def test_only_the_called_interfaces_are_required(self):
+        self.check()
+        self.check(nm=SYMBOLS + '0010 T sgemm_\n')
+
+    def test_reject_wrong_or_missing_proof(self):
+        for trace, nm in [
+            (RECORDS.replace(str(COB),'/foreign/libcob_matmul.a'), SYMBOLS),
+            (RECORDS.replace(str(BLAS),'/foreign/libopenblas.a'), SYMBOLS),
+            (RECORDS + '\nld: /foreign/lib.so: definition of cblas_sgemm', SYMBOLS),
+            (RECORDS.replace('reference to cblas_sgemm','reference to sgemm_'), SYMBOLS),
+            (RECORDS, SYMBOLS.replace('openblas_get_num_threads','sgemm_')),
+            (RECORDS, SYMBOLS.replace('T cblas_sgemm','U cblas_sgemm')),
+        ]:
+            with self.subTest(trace=trace, nm=nm), self.assertRaisesRegex(ValueError,'cblas_sgemm|openblas_get_num_threads'):
+                self.check(trace,nm)
+
+
+if __name__ == '__main__':
+    unittest.main()
