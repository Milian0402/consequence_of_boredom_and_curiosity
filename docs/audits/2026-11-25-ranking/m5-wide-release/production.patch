         !cob_f32_ranges_overlap(c, (size_t)(m - 1) * ldc + n, a, (size_t)(m - 1) * lda + k) &&
diff --git a/tests/test_apple_medium_wide.c b/tests/test_apple_medium_wide.c
new file mode 100644
index 0000000..7adafe5
--- /dev/null
+++ b/tests/test_apple_medium_wide.c
@@ -0,0 +1,47 @@
+#include "cob_gemm.h"
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+static int run_case(int m, int n, int k, int pad)
+{
+    const int lda = k + pad, ldb = n + pad, ldc = n + pad + 1;
+    const float guard = -8765.0f;
+    float *a = malloc((size_t)m * lda * sizeof(*a));
+    float *b = malloc((size_t)k * ldb * sizeof(*b));
+    float *c = malloc(((size_t)m * ldc + 1) * sizeof(*c));
+    if (!a || !b || !c) exit(EXIT_FAILURE);
+    for (int i = 0; i < m; ++i)
+        for (int p = 0; p < lda; ++p)
+            a[(size_t)i * lda + p] = p < k ? (float)((i * 23 + p * 13) % 31 - 15) / 16.0f : NAN;
+    for (int p = 0; p < k; ++p)
+        for (int j = 0; j < ldb; ++j)
+            b[(size_t)p * ldb + j] = j < n ? (float)((p * 17 + j * 11) % 29 - 14) / 16.0f : NAN;
+    for (int i = 0; i < m; ++i)
+        for (int j = 0; j < ldc; ++j) c[(size_t)i * ldc + j] = j < n ? NAN : guard;
+    c[(size_t)m * ldc] = guard;
+    cob_sgemm_rowmajor(m, n, k, a, lda, b, ldb, c, ldc);
+    int ok = c[(size_t)m * ldc] == guard;
+    for (int i = 0; i < m; ++i) {
+        for (int j = 0; j < n; ++j) {
+            double expected = 0;
+            for (int p = 0; p < k; ++p)
+                expected += (double)a[(size_t)i * lda + p] * b[(size_t)p * ldb + j];
+            if ((double)c[(size_t)i * ldc + j] != expected) ok = 0;
+        }
+        for (int j = n; j < ldc; ++j)
+            if (c[(size_t)i * ldc + j] != guard) ok = 0;
+    }
+    free(a); free(b); free(c);
+    if (!ok) fprintf(stderr, "medium-wide mismatch for %d x %d x %d with pad %d\n", m, n, k, pad);
+    return ok;
+}
+
+int main(void)
+{
+    const int cases[][4] = {{24, 1024, 96, 0}, {31, 1087, 127, 3}, {48, 1153, 193, 7},
+                            {55, 4096, 384, 1}, {23, 1089, 131, 5}, {56, 1217, 147, 0}};
+    for (size_t i = 0; i < sizeof(cases) / sizeof(*cases); ++i)
+        if (!run_case(cases[i][0], cases[i][1], cases[i][2], cases[i][3])) return EXIT_FAILURE;
+    return EXIT_SUCCESS;
+}
diff --git a/third_party/maxmulsk/strassen_leaf.c b/third_party/maxmulsk/strassen_leaf.c
index 061a021..62f81df 100644
--- a/third_party/maxmulsk/strassen_leaf.c
+++ b/third_party/maxmulsk/strassen_leaf.c
@@ -1678,3 +1678,78 @@ int cob_sgemm_sme_tiny(int m, int n, int k, const float *a, int lda, const float
         return cob_rect_entry(m, n, k, a, lda, b, ldb, c, ldc);
     return cob_sme_tiny_legacy(m, n, k, a, lda, b, ldb, c, ldc);
 }
+
+#if defined(COB_ENABLE_APPLE_MEDIUM_WIDE) && COB_ENABLE_APPLE_MEDIUM_WIDE
+/* Stream one 64-column B panel through the first row tile. Keeping its packed
+   copy in the cache lets every subsequent A panel use the existing SME kernel. */
+__attribute__((always_inline)) static inline void
+cob_wide_first(int k, const float *ap, const float *b, int ldb, svcount_t cols,
+               float *bp) __arm_streaming __arm_inout("za")
+{
+    const svbool_t pg = svptrue_b32();
+    const svcount_t all = svptrue_c32();
+    svzero_za();
+    int p = 0;
+#define COB_WIDE_STEP(lhs, depth)                                                      \
+    do {                                                                               \
+        svfloat32x4_t rhs = svld1_f32_x4(cols, b + (size_t)(depth) * ldb);               \
+        svst1_f32_x4(all, bp + (size_t)(depth) * 64, rhs);                              \
+        svmopa_za32_f32_m(0, pg, pg, lhs, svget4_f32(rhs, 0));                         \
+        svmopa_za32_f32_m(1, pg, pg, lhs, svget4_f32(rhs, 1));                         \
+        svmopa_za32_f32_m(2, pg, pg, lhs, svget4_f32(rhs, 2));                         \
+        svmopa_za32_f32_m(3, pg, pg, lhs, svget4_f32(rhs, 3));                         \
+    } while (0)
+    for (; p + 4 <= k; p += 4) {
+        svfloat32x4_t av = svld1_f32_x4(all, ap + (size_t)p * 16);
+        COB_WIDE_STEP(svget4_f32(av, 0), p);
+        COB_WIDE_STEP(svget4_f32(av, 1), p + 1);
+        COB_WIDE_STEP(svget4_f32(av, 2), p + 2);
+        COB_WIDE_STEP(svget4_f32(av, 3), p + 3);
+    }
+    for (; p < k; ++p) {
+        svfloat32_t av = svld1_f32(pg, ap + (size_t)p * 16);
+        COB_WIDE_STEP(av, p);
+    }
+#undef COB_WIDE_STEP
+}
+
+__arm_locally_streaming __arm_new("za") static int
+cob_wide_run(int m, int n, int k, const float *a, int lda, const float *b, int ldb,
+             float *c, int ldc, float *ap, size_t depth, float *bp)
+{
+    if (svcntsw() != 16) return 0;
+    _Alignas(64) float stage[16 * 64];
+    pack_A_block(a, lda, 0, m, 0, k, depth, ap, stage);
+    for (int j = 0; j < n; j += 64) {
+        const int width = n - j < 64 ? n - j : 64;
+        if (width == 64)
+            cob_wide_first(k, ap, b + j, ldb, svptrue_c32(), bp);
+        else
+            cob_wide_first(k, ap, b + j, ldb, svwhilelt_c32_u64(0, (unsigned)width, 4), bp);
+        if (width == 64) store_za(c + j, ldc);
+        else cob_sme_transfer_short_c(16, width, c + j, ldc, 1);
+        for (int i = 16; i < m; i += 16) {
+            const int height = m - i < 16 ? m - i : 16;
+            float *dst = c + (size_t)i * ldc + j;
+            svzero_za();
+            micro_kernel_1x4(ap + i * depth, bp, k);
+            if (width == 64 && height == 16) store_za(dst, ldc);
+            else cob_sme_transfer_short_c(height, width, dst, ldc, 1);
+        }
+    }
+    return 1;
+}
+
+int cob_sgemm_sme_medium_wide(int m, int n, int k, const float *a, int lda,
+                             const float *b, int ldb, float *c, int ldc)
+{
+    const size_t depth = ((size_t)k + 63) & ~(size_t)63;
+    const size_t rows = ((size_t)m + 15) & ~(size_t)15;
+    const size_t a_size = rows * depth;
+    float *packed = aligned_alloc(64, (a_size + (size_t)k * 64) * sizeof(*packed));
+    if (!packed) return 0;
+    const int done = cob_wide_run(m, n, k, a, lda, b, ldb, c, ldc, packed, depth, packed + a_size);
+    free(packed);
+    return done;
+}
+#endif
