+__attribute__((always_inline)) static inline int
+cob_numeric_shape(int bands,int m,int n,int k,const float *a,int lda,const float *b,int ldb,float *c,int ldc)
+    __arm_streaming __arm_inout("za")
+{
+    svuint32_t abits=svdup_u32(0),bbits=abits;
+    cob_numeric_panel(bands,16,n,k,a,lda,b,ldb,c,ldc,&abits,&bbits,1);
+    for(int i=16;i<48;i+=16)
+        cob_numeric_panel(bands,16,n,k,a+(size_t)i*lda,lda,b,ldb,c+(size_t)i*ldc,ldc,&abits,&bbits,0);
+    cob_numeric_panel(bands,m-48,n,k,a+48*(size_t)lda,lda,b,ldb,c+48*(size_t)ldc,ldc,&abits,&bbits,0);
+    return cob_upper_risky(svorr_u32_x(svptrue_b32(),abits,bbits)) ? 2 : 1;
+}
+__arm_new("za") __arm_locally_streaming static int
+cob_numeric_upper(int m,int n,int k,const float *a,int lda,const float *b,int ldb,float *c,int ldc)
+{
+    if (svcntsw()!=16) return 0;
+    if (n<=32) return cob_numeric_shape(2,m,n,k,a,lda,b,ldb,c,ldc);
+    return cob_numeric_shape(3,m,n,k,a,lda,b,ldb,c,ldc);
+}
