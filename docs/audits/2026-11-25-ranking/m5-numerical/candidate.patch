+__attribute__((always_inline)) static inline void
+cob_numeric_dot(int bands, int full_pair, svbool_t last, svfloat32_t left, const float *right, svuint32_t *bits, int inspect_b)
+    __arm_streaming __arm_inout("za")
+{
+    const svbool_t all=svptrue_b32();
+    svfloat32_t r0,r1;
+    if (full_pair) {
+        svfloat32x2_t pair=svld1_f32_x2(svptrue_c32(),right);
+        r0=svget2_f32(pair,0); r1=svget2_f32(pair,1);
+    } else {
+        r0=svld1_f32(all,right); r1=svld1_f32(last,right+16);
+    }
+    if (inspect_b) *bits=cob_upper_bits(cob_upper_bits(*bits,r0),r1);
+    svmopa_za32_f32_m(0,all,all,left,r0);
+    svmopa_za32_f32_m(1,all,full_pair?all:last,left,r1);
+    if (bands==3) {
+        svfloat32_t r=svld1_f32(last,right+32);
+        if (inspect_b) *bits=cob_upper_bits(*bits,r);
+        svmopa_za32_f32_m(2,all,last,left,r);
+    }
+}
