+/* Use FP64 products and accumulation across each output row for operands
+   outside the small-magnitude fast range. The final cast rounds to FP32. */
+__attribute__((noinline)) static void
+cob_upper_wide(int m,int n,int k,const float *a,int lda,const float *b,int ldb,float *c,int ldc)
+{
+    for (int i=0;i<m;++i) {
+        double sums[48]={0};
+        for (int p=0;p<k;++p) {
+            double left=a[(size_t)i*lda+p];
+            const float *right=b+(size_t)p*ldb;
+            for (int j=0;j<n;++j) sums[j]+=left*(double)right[j];
+        }
+        float *out=c+(size_t)i*ldc;
+        for (int j=0;j<n;++j) out[j]=(float)sums[j];
+    }
+}
+/* Bit 30 of IEEE binary32 is set for every |x| >= 2, infinity or NaN.
+   Checking all active values bounds |sum A*B| and its forward rounding
+   error by 4*K*gamma(K), below .00055 for K <= 48. */
+__attribute__((always_inline)) static inline svuint32_t
+cob_upper_bits(svuint32_t bits, svfloat32_t x)
+    __arm_streaming
+{
+    return svorr_u32_x(svptrue_b32(),bits,svreinterpret_u32_f32(x));
+}
+__attribute__((always_inline)) static inline int
+cob_upper_risky(svuint32_t bits) __arm_streaming
+{
+    return (svorv_u32(svptrue_b32(),bits) & UINT32_C(0x40000000)) != 0;
+}
+__attribute__((always_inline)) static inline void
+cob_numeric_a(int rows, int depth, const float *a, int lda, svuint32_t *bits)
+    __arm_streaming __arm_inout("za")
+{
+    svbool_t depth_mask = svwhilelt_b32_s32(0,depth);
+    int i = 0;
+    for (; i + 4 <= rows; i += 4) {
+        const float *r = a + (size_t)i * lda;
+        svfloat32x4_t x = svcreate4_f32(svld1_f32(depth_mask,r),
+            svld1_f32(depth_mask,r+lda), svld1_f32(depth_mask,r+2*(size_t)lda),
+            svld1_f32(depth_mask,r+3*(size_t)lda));
+        svuint32_t x01=svorr_u32_x(svptrue_b32(),svreinterpret_u32_f32(svget4_f32(x,0)),svreinterpret_u32_f32(svget4_f32(x,1)));
+        svuint32_t x23=svorr_u32_x(svptrue_b32(),svreinterpret_u32_f32(svget4_f32(x,2)),svreinterpret_u32_f32(svget4_f32(x,3)));
+        *bits=svorr_u32_x(svptrue_b32(),*bits,svorr_u32_x(svptrue_b32(),x01,x23));
+        svwrite_hor_za32_f32_vg4(3,i,x);
+    }
+    for (; i < rows; ++i) {
+        svfloat32_t x=svld1_f32(depth_mask,a+(size_t)i*lda);
+        *bits=cob_upper_bits(*bits,x);
+        svwrite_hor_za32_f32_m(3,i,depth_mask,x);
+    }
+}
