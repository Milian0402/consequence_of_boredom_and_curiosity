+__attribute__((always_inline)) static inline void
+cob_numeric_panel(int bands, int rows, int n, int k, const float *a, int lda,
+               const float *b,int ldb,float *c,int ldc,svuint32_t *abits,svuint32_t *bbits,int inspect_b)
+    __arm_streaming __arm_inout("za")
+{
+    const svbool_t all=svptrue_b32(),last=svwhilelt_b32_s32(0,n-16*(bands-1));
+    const int full_pair=(bands==3);
+    svzero_za();
+    for(int p=0;p<k;p+=16) {
+        int depth=k-p<16?k-p:16;
+        cob_numeric_a(rows,depth,a+p,lda,abits);
+        int j=0;
+        for(;j+4<=depth;j+=4) {
+            svfloat32x4_t x=svread_ver_za32_f32_vg4(3,j);
+            const float *r=b+(size_t)(p+j)*ldb;
+            cob_numeric_dot(bands,full_pair,last,svget4_f32(x,0),r,bbits,inspect_b);
+            cob_numeric_dot(bands,full_pair,last,svget4_f32(x,1),r+ldb,bbits,inspect_b);
+            cob_numeric_dot(bands,full_pair,last,svget4_f32(x,2),r+2*(size_t)ldb,bbits,inspect_b);
+            cob_numeric_dot(bands,full_pair,last,svget4_f32(x,3),r+3*(size_t)ldb,bbits,inspect_b);
+        }
+        for(;j<depth;++j) {
+            svfloat32_t x=svread_ver_za32_f32_m(svundef_f32(),all,3,j);
+            cob_numeric_dot(bands,full_pair,last,x,b+(size_t)(p+j)*ldb,bbits,inspect_b);
+        }
+    }
+    for(int i=0;i<rows;++i) {
+        float *r=c+(size_t)i*ldc;
+        svst1_hor_za32(0,i,all,r);
+        svst1_hor_za32(1,i,full_pair?all:last,r+16);
+        if (bands==3) svst1_hor_za32(2,i,last,r+32);
+    }
+}
